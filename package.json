{
  "name": "ui-kit",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "npm run build -w ui-kit && npm run build -w @workspace/storybook",
    "dev": "concurrently \"npm run dev -w ui-kit\" \"npm run storybook -w @workspace/storybook\"",
    "storybook": "npm run storybook -w @workspace/storybook",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm run test -w @workspace/storybook",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
