{
  "name": "ui-kit",
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "styles.d.ts"
  ],
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --minify",
    "build": "npm run build:js && npm run build:css",

    "dev:js": "tsup --watch",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/styles.css --watch",
    "dev": "concurrently \"npm run dev:js\" \"npm run dev:css\"",

    "lint": "eslint",
    "typecheck": "tsc --noEmit",

    "prepack": "npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6",
    "typescript-eslint": "^8"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./styles.css": {
      "types": "./styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
